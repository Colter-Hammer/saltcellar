{
  "openapi": "3.1.0",
  "info": {
    "title": "Saltcellar",
    "description": "The Saltcellar HTTP API.",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/categories": {
      "get": {
        "tags": [
          "categories"
        ],
        "summary": "`GET /api/v1/categories`: every group in order, each with its categories in order.",
        "operationId": "getCategories",
        "responses": {
          "200": {
            "description": "Every group and category, hidden ones included.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryList"
                }
              }
            }
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "categories"
        ],
        "summary": "`POST /api/v1/categories`: adds a category at the end of its group.",
        "operationId": "addCategory",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewCategory"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The category is added.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Created"
                }
              }
            }
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: there's no such group.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`: the name is empty, too long or taken in the group.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories/order": {
      "put": {
        "tags": [
          "categories"
        ],
        "summary": "`PUT /api/v1/categories/order`: puts every group and category in order.",
        "operationId": "orderCategories",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryOrder"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The order is saved."
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "`categories_changed`: the order doesn't list every group and category exactly once; `name_taken`: a moved category's name is taken in its new group.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories/starter": {
      "post": {
        "tags": [
          "categories"
        ],
        "summary": "`POST /api/v1/categories/starter`: writes the starter categories and the always-review payees.",
        "operationId": "useStarterCategories",
        "responses": {
          "204": {
            "description": "The starter categories are written."
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "`categories_exist`: there's a group already.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories/{id}": {
      "delete": {
        "tags": [
          "categories"
        ],
        "summary": "`DELETE /api/v1/categories/{id}`: deletes a category. Until transactions exist nothing uses\none, so every category can be; after, one in use answers `category_in_use` and can be hidden.",
        "operationId": "deleteCategory",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The category.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The category is deleted."
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: there's no such category.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "categories"
        ],
        "summary": "`PATCH /api/v1/categories/{id}`: renames a category, hides it or shows it again.",
        "operationId": "changeCategory",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The category.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The category is changed."
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: there's no such category.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`: the name is empty, too long or taken in its group.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/category-groups": {
      "post": {
        "tags": [
          "categories"
        ],
        "summary": "`POST /api/v1/category-groups`: adds a group at the end.",
        "operationId": "addCategoryGroup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewCategoryGroup"
              }

{
  "openapi": "3.1.0",
  "info": {
    "title": "Saltcellar",
    "description": "The Saltcellar HTTP API.",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "`GET /api/v1/health`, no auth, for the Docker healthcheck: 200 when the database answers.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The server and its database answer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database isn't answering.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/household": {
      "get": {
        "tags": [
          "household"
        ],
        "summary": "`GET /api/v1/household`: the household's currency and timezone.",
        "operationId": "getHousehold",
        "responses": {
          "200": {
            "description": "The household.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Household"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/password-reset": {
      "post": {
        "tags": [
          "reset"
        ],
        "summary": "`POST /api/v1/password-reset`: sets a new password with a reset link, which then stops working,\nand logs in. The login's other sessions end *(agent)*.",
        "operationId": "usePasswordReset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UseReset"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The password is set and this browser is logged in.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "The session cookie."
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "`reset_link_dead`: it expired, was used, or a newer one replaced it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`, naming each field that's wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/password-reset/check": {
      "post": {
        "tags": [
          "reset"
        ],
        "summary": "`POST /api/v1/password-reset/check`: whether a reset link still works, for the page to say so\nbefore anyone types a password.",
        "operationId": "checkPasswordReset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckReset"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The link works."
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "`reset_link_dead`: it expired, was used, or a newer one replaced it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profile": {
      "get": {
        "tags": [
          "profile"
        ],
        "summary": "`GET /api/v1/profile`: the logged-in login's profile.",
        "operationId": "getProfile",
        "responses": {
          "200": {
            "description": "The profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "profile"
        ],
        "summary": "`PUT /api/v1/profile`: saves the display name, locale and week start.",
        "operationId": "changeProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeProfile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The saved profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`, naming each field that's wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profile/password": {
      "post": {
        "tags": [
          "profile"
        ],
        "summary": "`POST /api/v1/profile/password`: changes the password, given the current one. Wrong current\npasswords count towards the login throttle, keyed on the username *(agent)*. Every session\nstays logged in; Log out everywhere ends them.",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePassword"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The password is changed."
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`, naming each field that's wrong, the current password among them.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`: too many wrong passwords for this login; wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "`GET /api/v1/session`: who is logged in.",
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "The login this session belongs to.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "session"
        ],
        "summary": "`POST /api/v1/session`: logs in.",
        "operationId": "logIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Logged in.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "The session cookie."
              }
            }
          },
          "401": {
            "description": "`login_failed`: the username or the password is wrong; it doesn't say which.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`: too many failures for this username; wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "session"
        ],
        "summary": "`DELETE /api/v1/session`: logs out, deleting this session.",
        "operationId": "logOut",
        "responses": {
          "204": {
            "description": "Logged out.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Clears the session cookie."
              }
            }
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "delete": {
        "tags": [
          "profile"
        ],
        "summary": "`DELETE /api/v1/sessions`: logs out everywhere, deleting every session this login has, this\none included.",
        "operationId": "logOutEverywhere",
        "responses": {
          "204": {
            "description": "Every session of this login has ended.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Clears the session cookie."
              }
            }
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup": {
      "get": {
        "tags": [
          "setup"
        ],
        "summary": "`GET /api/v1/setup`: whether setup is finished.",
        "operationId": "getSetup",
        "responses": {
          "200": {
            "description": "Whether setup is finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "setup"
        ],
        "summary": "`POST /api/v1/setup`: finishes setup. Writes the household and the first login in one go, and\nlogs that login in.",
        "operationId": "finishSetup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinishSetup"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Setup is finished and the new login is logged in.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "The session cookie."
              }
            }
          },
          "403": {
            "description": "`setup_code_wrong`: the code isn't the setup code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "`setup_done`: setup is already finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`, naming each field that's wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`: too many wrong codes; wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup/code": {
      "post": {
        "tags": [
          "setup"
        ],
        "summary": "`POST /api/v1/setup/code`: whether this is the setup code, for the wizard's first step.",
        "operationId": "checkSetupCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckSetupCode"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "It's the setup code."
          },
          "403": {
            "description": "`setup_code_wrong`: it isn't.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "`setup_done`: setup is already finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`: too many wrong codes; wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup/currencies": {
      "get": {
        "tags": [
          "setup"
        ],
        "summary": "`GET /api/v1/setup/currencies`: the currencies the household can choose.",
        "operationId": "getCurrencies",
        "responses": {
          "200": {
            "description": "Every ISO 4217 code in circulation, sorted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangePassword": {
        "type": "object",
        "required": [
          "current_password",
          "password",
          "password_again"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "description": "At least 12 characters."
          },
          "password_again": {
            "type": "string",
            "description": "The new password typed again."
          }
        }
      },
      "ChangeProfile": {
        "type": "object",
        "required": [
          "display_name"
        ],
        "properties": {
          "display_locale": {
            "type": [
              "string",
              "null"
            ],
            "description": "BCP 47, like `de-DE`; null = the browser's locale."
          },
          "display_name": {
            "type": "string"
          },
          "week_start": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "0 = Sunday … 6 = Saturday; null = from the locale."
          }
        }
      },
      "CheckReset": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "The token from the link's fragment."
          }
        }
      },
      "CheckSetupCode": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "As typed: case, spaces and dashes don't matter."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "What went wrong, for code to branch on: `snake_case`, stable."
          },
          "fields": {
            "type": "object",
            "description": "Validation errors only: each field that's wrong and why.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "message": {
            "type": "string",
            "description": "What went wrong, for a person to read."
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "description": "The body of every error response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "FinishSetup": {
        "type": "object",
        "required": [
          "code",
          "currency",
          "timezone",
          "display_name",
          "username",
          "password",
          "password_again"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The setup code again, as typed."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217, one of `GET /api/v1/setup/currencies`."
          },
          "display_name": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "description": "At least 12 characters."
          },
          "password_again": {
            "type": "string",
            "description": "The password typed again."
          },
          "timezone": {
            "type": "string",
            "description": "An IANA timezone name."
          },
          "username": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok`: any other state is an error response.",
            "example": "ok"
          }
        }
      },
      "Household": {
        "type": "object",
        "required": [
          "currency",
          "timezone"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "description": "ISO 4217: every amount is in minor units of it.",
            "example": "USD"
          },
          "timezone": {
            "type": "string",
            "description": "IANA: it decides what \"today\" is.",
            "example": "America/Chicago"
          }
        }
      },
      "LogIn": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string",
            "description": "As typed: case and surrounding spaces don't matter."
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "username",
          "display_name"
        ],
        "properties": {
          "display_locale": {
            "type": [
              "string",
              "null"
            ],
            "description": "BCP 47, like `de-DE`; null = the browser's locale."
          },
          "display_name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "week_start": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "0 = Sunday … 6 = Saturday; null = from the locale.",
            "maximum": 6,
            "minimum": 0
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "username",
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "done"
        ],
        "properties": {
          "done": {
            "type": "boolean",
            "description": "Whether setup is finished. Until it is, the app shows only the setup wizard."
          }
        }
      },
      "UseReset": {
        "type": "object",
        "required": [
          "token",
          "password",
          "password_again"
        ],
        "properties": {
          "password": {
            "type": "string",
            "description": "At least 12 characters."
          },
          "password_again": {
            "type": "string",
            "description": "The password typed again."
          },
          "token": {
            "type": "string",
            "description": "The token from the link's fragment."
          }
        }
      }
    }
  }
}

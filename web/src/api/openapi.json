              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "profile"
        ],
        "summary": "`PUT /api/v1/profile`: saves the display name, locale and week start.",
        "operationId": "changeProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeProfile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The saved profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`, naming each field that's wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profile/password": {
      "post": {
        "tags": [
          "profile"
        ],
        "summary": "`POST /api/v1/profile/password`: changes the password, given the current one. Wrong current\npasswords count towards the login throttle, keyed on the username *(agent)*. Every session\nstays logged in; Log out everywhere ends them.",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePassword"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The password is changed."
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`, naming each field that's wrong, the current password among them.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`: too many wrong passwords for this login; wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "`GET /api/v1/session`: who is logged in.",
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "The login this session belongs to.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "session"
        ],
        "summary": "`POST /api/v1/session`: logs in.",
        "operationId": "logIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Logged in.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "The session cookie."
              }
            }
          },
          "401": {
            "description": "`login_failed`: the username or the password is wrong; it doesn't say which.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`: too many failures for this username; wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "session"
        ],
        "summary": "`DELETE /api/v1/session`: logs out, deleting this session.",
        "operationId": "logOut",
        "responses": {
          "204": {
            "description": "Logged out.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Clears the session cookie."
              }
            }
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "delete": {
        "tags": [
          "profile"
        ],
        "summary": "`DELETE /api/v1/sessions`: logs out everywhere, deleting every session this login has, this\none included.",
        "operationId": "logOutEverywhere",
        "responses": {
          "204": {
            "description": "Every session of this login has ended.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Clears the session cookie."
              }
            }
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup": {
      "get": {
        "tags": [
          "setup"
        ],
        "summary": "`GET /api/v1/setup`: whether setup is finished.",
        "operationId": "getSetup",
        "responses": {
          "200": {
            "description": "Whether setup is finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "setup"
        ],
        "summary": "`POST /api/v1/setup`: finishes setup. Writes the household and the first login in one go, and\nlogs that login in.",
        "operationId": "finishSetup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinishSetup"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Setup is finished and the new login is logged in.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "The session cookie."
              }
            }
          },
          "403": {
            "description": "`setup_code_wrong`: the code isn't the setup code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "`setup_done`: setup is already finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`, naming each field that's wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`: too many wrong codes; wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup/code": {
      "post": {
        "tags": [
          "setup"
        ],
        "summary": "`POST /api/v1/setup/code`: whether this is the setup code, for the wizard's first step.",
        "operationId": "checkSetupCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckSetupCode"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "It's the setup code."
          },
          "403": {
            "description": "`setup_code_wrong`: it isn't.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "`setup_done`: setup is already finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`: too many wrong codes; wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup/currencies": {
      "get": {
        "tags": [
          "setup"
        ],
        "summary": "`GET /api/v1/setup/currencies`: the currencies the household can choose.",
        "operationId": "getCurrencies",
        "responses": {
          "200": {
            "description": "Every ISO 4217 code in circulation, sorted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActualUpload": {
        "type": "object",
        "description": "An uploaded Actual export and what's in it.",
        "required": [
          "id",
          "budget_name",
          "accounts",
          "transactions",
          "categories",
          "first_date",
          "last_date"
        ],
        "properties": {
          "accounts": {
            "type": "integer",
            "format": "int64",
            "description": "Live accounts, closed ones included.",
            "minimum": 0
          },
          "budget_name": {
            "type": "string",
            "description": "The budget's name in Actual.",
            "example": "Our budget"
          },
          "categories": {
            "type": "integer",
            "format": "int64",
            "description": "Live categories.",
            "minimum": 0
          },
          "first_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "The earliest transaction's date, `YYYY-MM-DD`; null when there are none."
          },
          "id": {
            "type": "string",
            "description": "Names this upload in the importer's next steps."
          },
          "last_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "The latest transaction's date, `YYYY-MM-DD`; null when there are none."
          },
          "transactions": {
            "type": "integer",
            "format": "int64",
            "description": "Live transactions in live accounts; a split counts once.",
            "minimum": 0
          }
        }
      },
      "Category": {
        "type": "object",
        "required": [
          "id",
          "name",
          "hidden"
        ],
        "properties": {
          "hidden": {
            "type": "boolean"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CategoryChange": {
        "type": "object",
        "description": "What a change to a group or a category sets; a field left out stays as it is.",
        "properties": {
          "hidden": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CategoryGroup": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "hidden",
          "categories"
        ],
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "description": "In order, hidden ones included."
          },
          "hidden": {
            "type": "boolean",
            "description": "A hidden group hides its categories with it."
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "$ref": "#/components/schemas/CategoryGroupKind"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CategoryGroupKind": {
        "type": "string",
        "description": "Whether a group's categories are spending or money coming in.",
        "enum": [
          "expense",
          "income"
        ]
      },
      "CategoryGroupPlace": {
        "type": "object",
        "required": [
          "id",
          "categories"
        ],
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The group's categories' ids, in order."
          },
          "id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CategoryList": {
        "type": "object",
        "required": [
          "groups"
        ],
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryGroup"
            },
            "description": "In order, hidden ones included."
          }
        }
      },
      "CategoryOrder": {
        "type": "object",
        "required": [
          "groups"
        ],
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryGroupPlace"
            },
            "description": "Every group, in order, each listing its categories: every group and every category exactly\nonce, hidden ones included. A category listed under another group moves to it."
          }
        }
      },
      "ChangePassword": {
        "type": "object",
        "required": [
          "current_password",
          "password",
          "password_again"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "description": "At least 12 characters."
          },
          "password_again": {
            "type": "string",
            "description": "The new password typed again."
          }
        }
      },
      "ChangeProfile": {
        "type": "object",
        "required": [
          "display_name"
        ],
        "properties": {
          "display_locale": {
            "type": [
              "string",
              "null"
            ],
            "description": "BCP 47, like `de-DE`; null = the browser's locale."
          },
          "display_name": {
            "type": "string"
          },
          "week_start": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "0 = Sunday … 6 = Saturday; null = from the locale."
          }
        }
      },
      "CheckReset": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "The token from the link's fragment."
          }
        }
      },
      "CheckSetupCode": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "As typed: case, spaces and dashes don't matter."
          }
        }
      },
      "Created": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "What went wrong, for code to branch on: `snake_case`, stable."
          },
          "fields": {
            "type": "object",
            "description": "Validation errors only: each field that's wrong and why.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "message": {
            "type": "string",
            "description": "What went wrong, for a person to read."
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "description": "The body of every error response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "FinishSetup": {
        "type": "object",
        "required": [
          "code",
          "currency",
          "timezone",
          "display_name",
          "username",
          "password",
          "password_again"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The setup code again, as typed."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217, one of `GET /api/v1/setup/currencies`."
          },
          "display_name": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "description": "At least 12 characters."
          },
          "password_again": {
            "type": "string",
            "description": "The password typed again."
          },
          "timezone": {
            "type": "string",
            "description": "An IANA timezone name."
          },
          "username": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok`: any other state is an error response.",
            "example": "ok"
          }
        }
      },
      "Household": {
        "type": "object",
        "required": [
          "currency",
          "timezone"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "description": "ISO 4217: every amount is in minor units of it.",
            "example": "USD"
          },
          "timezone": {
            "type": "string",
            "description": "IANA: it decides what \"today\" is.",
            "example": "America/Chicago"
          }
        }
      },
      "LogIn": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string",
            "description": "As typed: case and surrounding spaces don't matter."
          }
        }
      },
      "NewCategory": {
        "type": "object",
        "required": [
          "group_id",
          "name"
        ],
        "properties": {
          "group_id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "NewCategoryGroup": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/CategoryGroupKind"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "username",
          "display_name"
        ],
        "properties": {
          "display_locale": {
            "type": [
              "string",
              "null"
            ],
            "description": "BCP 47, like `de-DE`; null = the browser's locale."
          },
          "display_name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "week_start": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "0 = Sunday … 6 = Saturday; null = from the locale.",
            "maximum": 6,
            "minimum": 0
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "username",
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "done"
        ],
        "properties": {
          "done": {
            "type": "boolean",
            "description": "Whether setup is finished. Until it is, the app shows only the setup wizard."
          }
        }
      },
      "UseReset": {
        "type": "object",
        "required": [
          "token",
          "password",
          "password_again"
        ],
        "properties": {
          "password": {
            "type": "string",
            "description": "At least 12 characters."
          },
          "password_again": {
            "type": "string",
            "description": "The password typed again."
          },
          "token": {
            "type": "string",
            "description": "The token from the link's fragment."
          }
        }
      }
    }
  }
}

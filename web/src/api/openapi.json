                  "$ref": "#/components/schemas/Created"
                }
              }
            }
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`: the name is empty, too long or taken.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/category-groups/{id}": {
      "delete": {
        "tags": [
          "categories"
        ],
        "summary": "`DELETE /api/v1/category-groups/{id}`: deletes an empty group.",
        "operationId": "deleteCategoryGroup",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The group.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The group is deleted."
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: there's no such group.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "`group_not_empty`: it still holds categories, hidden ones included.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "categories"
        ],
        "summary": "`PATCH /api/v1/category-groups/{id}`: renames a group, hides it or shows it again.",
        "operationId": "changeCategoryGroup",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The group.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The group is changed."
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: there's no such group.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`: the name is empty, too long or taken.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "`GET /api/v1/health`, no auth, for the Docker healthcheck: 200 when the database answers.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The server and its database answer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database isn't answering.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/household": {
      "get": {
        "tags": [
          "household"
        ],
        "summary": "`GET /api/v1/household`: the household's currency and timezone.",
        "operationId": "getHousehold",
        "responses": {
          "200": {
            "description": "The household.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Household"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/imports/actual": {
      "post": {
        "tags": [
          "import"
        ],
        "summary": "`POST /api/v1/imports/actual`: reads an Actual export.",
        "operationId": "uploadActualExport",
        "requestBody": {
          "description": "The `.zip` Actual's Settings › Export data saves, as is. At most 100 MB.",
          "content": {
            "application/zip": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The export is read; nothing is imported yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActualUpload"
                }
              }
            }
          },
          "401": {
            "description": "`login_required`: no live session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "`currency_not_supported`: the household currency doesn't have 2 decimal places, as Actual's amounts do; `earlier_import`: an earlier import from Actual hasn't been undone.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "`file_too_large`: over 100 MB, or unpacks to more than the app reads.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "`zip_required`: the body isn't sent as `application/zip`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`not_an_actual_export`, or `export_unreadable`: an Actual export with data the app can't read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/password-reset": {
      "post": {
        "tags": [
          "reset"
        ],
        "summary": "`POST /api/v1/password-reset`: sets a new password with a reset link, which then stops working,\nand logs in. The login's other sessions end *(agent)*.",
        "operationId": "usePasswordReset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UseReset"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The password is set and this browser is logged in.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "The session cookie."
              }
            }
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "`reset_link_dead`: it expired, was used, or a newer one replaced it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "`validation_failed`, naming each field that's wrong.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/password-reset/check": {
      "post": {
        "tags": [
          "reset"
        ],
        "summary": "`POST /api/v1/password-reset/check`: whether a reset link still works, for the page to say so\nbefore anyone types a password.",
        "operationId": "checkPasswordReset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckReset"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The link works."
          },
          "403": {
            "description": "`setup_required`: setup isn't finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "`reset_link_dead`: it expired, was used, or a newer one replaced it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profile": {
      "get": {
        "tags": [
          "profile"
        ],
        "summary": "`GET /api/v1/profile`: the logged-in login's profile.",
        "operationId": "getProfile",
        "responses": {

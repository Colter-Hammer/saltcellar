{
  "name": "saltcellar-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc -b",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "1.63.0",
    "@tanstack/vue-query": "5.105.0",
    "@tanstack/vue-table": "9.3.1",
    "clsx": "2.1.1",
    "openapi-fetch": "0.17.0",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
